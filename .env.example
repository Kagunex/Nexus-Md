# Firebase Web App configuration for a dedicated NEXORA MD project
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only: base64-encoded service account JSON. Never expose with NEXT_PUBLIC_.
NEXORA_FIREBASE_SERVICE_ACCOUNT_BASE64=

# Optional future persistent Baileys worker adapter. No worker is bundled or active by default.
NEXORA_BAILEYS_WORKER_URL=
NEXORA_BAILEYS_WORKER_TOKEN=

# Optional keys for legacy bot commands only (server/worker environment, never NEXT_PUBLIC_)
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=
TIMEZONEDB_API_KEY=
